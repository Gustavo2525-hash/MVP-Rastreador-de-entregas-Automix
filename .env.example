PORT=3000
PGHOST=your-supabase-session-pooler-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=replace-with-your-database-password
PGSSL=true
PGPOOL_MAX=3
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
